# =====================================================================
# LOCAL DEVELOPMENT: Copy this file to .env and fill in real values.
#
# RENDER DEPLOYMENT: These same variable names must also be entered into
# Render's dashboard under the service's Environment tab. This file is
# NOT automatically read by Render — the dashboard is the source of
# truth for production environment variables.
#
# NOTE: DATABASE_URL's current default (SQLite) will need to change once
# a persistent disk is attached on Render. Not yet done — do NOT change
# the default value here yet.
# =====================================================================

# Copy this file to .env and fill in real values. Never commit the real .env file.
DATABASE_URL=sqlite+aiosqlite:///./norman_shop.db
GEMINI_API_KEY=your-gemini-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
MESSENGER_VERIFY_TOKEN=your-webhook-verify-token-here
MESSENGER_PAGE_ACCESS_TOKEN=your-facebook-page-access-token-here
JWT_SECRET_KEY=generate-a-random-secret-key-here
ENVIRONMENT=development
PORT=8000
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your-bcrypt-password-hash-here
META_APP_SECRET=your-meta-app-secret-here
STAFF_HANDOFF_ENABLED=true
